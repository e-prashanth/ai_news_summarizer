# Required for summarisation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Retry temporary network or server interruptions up to this many total attempts.
GEMINI_MAX_ATTEMPTS=3

# The calendar used for "previous day"
NEWS_TIMEZONE=Asia/Kolkata
MAX_ARTICLES=20
MAX_ARTICLES_PER_SOURCE=4

# Optional SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=
